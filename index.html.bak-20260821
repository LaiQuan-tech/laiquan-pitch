<script>
(function(){
  var slides=[].slice.call(document.querySelectorAll('.slide'));
  var dotsWrap=document.getElementById('dots');
  var pfill=document.getElementById('pfill');
  var total=slides.length, active=0;

  slides.forEach(function(s,i){
    var b=document.createElement('button');
    b.type='button';
    b.setAttribute('aria-label','前往：'+(s.dataset.label||('第 '+(i+1)+' 頁')));
    b.innerHTML='<span class="lbl">'+(s.dataset.label||(i+1))+'</span>';
    b.addEventListener('click',function(){ slides[i].scrollIntoView({behavior:'smooth'}); });
    dotsWrap.appendChild(b);
  });
  var dots=[].slice.call(dotsWrap.children);

  function setActive(i){
    if(i===active) return;
    active=i;
    dots.forEach(function(d,j){ d.setAttribute('data-active', j===i?'true':'false'); });
    if(pfill) pfill.style.width=((i+1)/total*100)+'%';
  }
  dots[0].setAttribute('data-active','true');
  if(pfill) pfill.style.width=(1/total*100)+'%';

  if('IntersectionObserver' in window){
    var actObs=new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(e.isIntersecting && e.intersectionRatio>=0.55){ setActive(slides.indexOf(e.target)); }
      });
    },{threshold:[0.55]});
    slides.forEach(function(s){ actObs.observe(s); });

    var revObs=new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(e.isIntersecting) e.target.classList.add('in');
        else e.target.classList.remove('in');
      });
    },{threshold:0.18});
    document.querySelectorAll('.reveal').forEach(function(r){ revObs.observe(r); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(r){ r.classList.add('in'); });
  }

  window.addEventListener('keydown',function(ev){
    var k=ev.key;
    if(k==='ArrowDown'||k==='PageDown'||k===' '||k==='Spacebar'){ ev.preventDefault(); if(active<total-1) slides[active+1].scrollIntoView({behavior:'smooth'}); }
    else if(k==='ArrowUp'||k==='PageUp'){ ev.preventDefault(); if(active>0) slides[active-1].scrollIntoView({behavior:'smooth'}); }
    else if(k==='Home'){ ev.preventDefault(); slides[0].scrollIntoView({behavior:'smooth'}); }
    else if(k==='End'){ ev.preventDefault(); slides[total-1].scrollIntoView({behavior:'smooth'}); }
  });
})();
</script>
</body>
</html>
